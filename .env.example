# Core application settings (required in production)
TMDB_API_KEY=your_tmdb_api_key
DB_URL=postgresql://USER:PASSWORD@localhost:5432/bingesaga
JWT_SECRET_TOKEN=replace_with_a_long_random_secret
REDIS_URL=redis://localhost:6379/0

# Authentication
REFRESH_TOKEN_EXPIRE_DAYS=7

# Optional Twilio OTP integration
TWILIO_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_API_SECRET=
TWILIO_PHONE_NUMBER=

# Optional Cloudinary media integration
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=bingesaga

# Optional Celery overrides (defaults to REDIS_URL when blank)
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# Optional Redis and background-dispatch tuning
REDIS_SOCKET_CONNECT_TIMEOUT=2
REDIS_SOCKET_TIMEOUT=2
REDIS_HEALTH_CHECK_INTERVAL=30
REDIS_MAX_CONNECTIONS=50
BACKGROUND_DISPATCH_QUEUE_SIZE=1000
BACKGROUND_DISPATCH_PUBLISHERS=2
AUDIT_EVENT_QUEUE_SIZE=1000
AUDIT_EVENT_BATCH_SIZE=50
AUDIT_EVENT_BATCH_WAIT_MS=50
